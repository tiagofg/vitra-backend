# Copie para .env e ajuste. Nada aqui é segredo real.
VITRA_AMBIENTE=dev
VITRA_DEBUG=true

# A aplicação conecta como `vitra_runtime` — não é dono das tabelas e não tem BYPASSRLS.
# É o que faz o Row-Level Security valer de verdade: dono e superusuário ignoram política.
VITRA_DATABASE_URL=postgresql+asyncpg://vitra_runtime:vitra_runtime@localhost:5433/vitra

# Não existe variável de banco de teste: a suíte sobe um Postgres 17 descartável por
# execução e sobrescreve `VITRA_DATABASE_URL` com ele. Para reaproveitar um Postgres já de
# pé e não esperar o container a cada rodada, use `VITRA_TESTE_URL_EXTERNA` — o schema
# continua sendo recriado a partir das migrações.

# Só o Alembic usa: migração cria e altera tabela, então roda como dono.
VITRA_DATABASE_URL_ADMIN=postgresql+asyncpg://vitra:vitra@localhost:5433/vitra

# Banco COMPARTILHADO do bake-off (`vitra_bakeoff`, Neon/São Paulo).
# Traz senha real: mora só no .env, nunca no repositório — aqui vai apenas o nome da
# variável. As três stacks do bake-off apontam para este banco ao mesmo tempo, então a
# estrutura é fixa (nada de DDL) e escrita automatizada é proibida. Sem esta variável, os
# testes que dependem dela são pulados.
# VITRA_BAKEOFF_DATABASE_URL=postgresql+asyncpg://USUARIO:SENHA@HOST.neon.tech/vitra_bakeoff?ssl=require

# Troque em produção: openssl rand -hex 32
VITRA_JWT_SECRET=troque-esta-chave-em-producao-0000000000000000
VITRA_JWT_ACCESS_TTL_MINUTOS=60
VITRA_JWT_REFRESH_TTL_DIAS=7

VITRA_CORS_ORIGENS=["http://localhost:3000"]

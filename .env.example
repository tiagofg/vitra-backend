# Copie para .env e ajuste. Nada aqui é segredo real.
VITRA_AMBIENTE=dev
VITRA_DEBUG=true

VITRA_DATABASE_URL=postgresql+asyncpg://vitra:vitra@localhost:5433/vitra
VITRA_DATABASE_URL_TESTE=postgresql+asyncpg://vitra:vitra@localhost:5433/vitra_teste

# Troque em produção: openssl rand -hex 32
VITRA_JWT_SECRET=troque-esta-chave-em-producao-0000000000000000
VITRA_JWT_ACCESS_TTL_MINUTOS=60
VITRA_JWT_REFRESH_TTL_DIAS=7

VITRA_CORS_ORIGENS=["http://localhost:3000"]
